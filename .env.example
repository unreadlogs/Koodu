# --- Server -------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Comma separated list of allowed browser origins (dev default below).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Slice 1) -----------------------------------------------------
# Set this to require a password at /session/auth before the app loads.
# Leave unset to disable auth entirely (developer mode / tests).
# KOODU_AUTH_PASSWORD=change-me-opens-escape-123

# --- Local model (server-side, never in the browser) --------------------
# Any OpenAI-compatible local server (Ollama, llama.cpp server, vLLM).
# Leave LOCAL_LLM_BASE_URL unset to keep local inference disabled.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=

# --- Cloud model (server-side only; keys must never reach the browser) --
# Leave CLOUD_LLM_BASE_URL unset to keep cloud routing disabled.
# CLOUD_LLM_BASE_URL=https://api.example.com/v1
# CLOUD_LLM_MODEL=
# CLOUD_LLM_API_KEY=

LLM_TIMEOUT_MS=15000
