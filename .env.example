# --- Server -------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Comma separated list of allowed browser origins (dev default below).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Slice 1) -----------------------------------------------------
# Set this to require a password at /session/auth before the app loads.
# Leave unset to disable auth entirely (developer mode / tests).
# KOODU_AUTH_PASSWORD=change-me-opens-escape-123

# --- Local model (server-side, never in the browser) --------------------
# Choose one:
#   needle  = Cactus Needle 3 in this server process (~35MB, tool-calling)
#   openai  = any OpenAI-compatible local server (Ollama, llama.cpp, vLLM)
#   unset   = local inference disabled; /api/intelligence/local returns 501
LOCAL_LLM_PROVIDER=needle

# Needle 3 is opt-in because it downloads pinned weights from Hugging Face:
#   pnpm models:download
# This copies the verified weights to assets/models/needle3.cact (git-ignored).
NEEDLE_MODEL_PATH=../../assets/models/needle3.cact

# If LOCAL_LLM_PROVIDER=openai instead:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=needle
# LOCAL_LLM_API_KEY=

# --- Cloud model (server-side only; keys must never reach the browser) --
# Leave CLOUD_LLM_BASE_URL unset to keep cloud routing disabled.
# CLOUD_LLM_BASE_URL=https://api.example.com/v1
# CLOUD_LLM_MODEL=
# CLOUD_LLM_API_KEY=

LLM_TIMEOUT_MS=15000
